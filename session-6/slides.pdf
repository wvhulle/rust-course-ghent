  /Contents (https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=use%20std::sync::Arc;%20use%20std::thread;%0A#[derive(Debug)]%0Astruct%20WhereDropped(Vec<i32>);%20///%20A%20struct%20that%20prints%20which%20thread%20drops%20it.%0Aimpl%20Drop%20for%20WhereDropped%20{%0A%20%20%20%20fn%20drop(%26mut%20self)%20{%20println!("Dropped%20by%20{:?}",%20%20thread::current().id())%20}%0A}%0Afn%20main()%20{%0A%20%20%20%20let%20v%20=%20Arc::new(WhereDropped(vec![10,%2020,%2030]));%0A%20%20%20%20let%20mut%20handles%20=%20Vec::new();%0A%20%20%20%20for%20i%20in%200..5%20{%0A%20%20%20%20%20%20%20%20let%20v%20=%20Arc::clone(%26v);%0A%20%20%20%20%20%20%20%20handles.push(thread::spawn(move%20||%20{%0A%20%20%20%20%20%20%20%20%20%20%20%20//%20Sleep%20for%200-500ms.%0A%20%20%20%20%20%20%20%20%20%20%20%20std::thread::sleep(std::time::Duration::from_millis(500%20-%20i%20*%20100));%0A%20%20%20%20%20%20%20%20%20%20%20%20let%20thread_id%20=%20thread::current().id();%0A%20%20%20%20%20%20%20%20%20%20%20%20println!("{thread_id:?}:%20{v:?}");%0A%20%20%20%20%20%20%20%20}));%0A%20%20%20%20}%0A%20%20%20%20drop(v);%20//%20Now%20only%20the%20spawned%20threads%20will%20hold%20clones%20of%20`v`.%0A%20%20%20%20//%20When%20the%20last%20spawned%20thread%20finishes,%20it%20will%20drop%20`v`'s%20contents.%0A%20%20%20%20handles.into_iter().for_each(|h|%20h.join().unwrap());%0A})
