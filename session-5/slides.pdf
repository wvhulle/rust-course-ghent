  /Contents (https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=use%20std::fs::File;%20use%20std::io::Read;%0Afn%20main()%20{%0A%20%20%20%20let%20file:%20Result<File,%20std::io::Error>%20=%20File::open("diary.txt");%0A%20%20%20%20match%20file%20{%0A%20%20%20%20%20%20%20%20Ok(mut%20file)%20=>%20{%0A%20%20%20%20%20%20%20%20%20%20%20%20let%20mut%20contents%20=%20String::new();%0A%20%20%20%20%20%20%20%20%20%20%20%20if%20let%20Ok(bytes)%20=%20file.read_to_string(%26mut%20contents)%20{%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20println!("Dear%20diary:%20{contents}%20({bytes}%20bytes)");%0A%20%20%20%20%20%20%20%20%20%20%20%20}%20else%20{%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20println!("Could%20not%20read%20file%20content");%0A%20%20%20%20%20%20%20%20%20%20%20%20}%0A%20%20%20%20%20%20%20%20}%0A%20%20%20%20%20%20%20%20Err(err)%20=>%20{%0A%20%20%20%20%20%20%20%20%20%20%20%20println!("The%20diary%20could%20not%20be%20opened:%20{err}");%0A%20%20%20%20%20%20%20%20}%0A%20%20%20%20}%0A})
