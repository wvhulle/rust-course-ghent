    /URI (https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=use%20tokio::sync::mpsc;%0A%0Aasync%20fn%20ping_handler(mut%20input:%20mpsc::Receiver<()>)%20{%0A%20%20%20%20let%20mut%20count:%20usize%20=%200;%0A%0A%20%20%20%20while%20let%20Some(_)%20=%20input.recv().await%20{%0A%20%20%20%20%20%20%20%20count%20+=%201;%0A%20%20%20%20%20%20%20%20println!("Received%20{count}%20pings%20so%20far.");%0A%20%20%20%20}%0A%0A%20%20%20%20println!("ping_handler%20complete");%0A}%0A%0A#[tokio::main]%0Aasync%20fn%20main()%20{%0A%20%20%20%20let%20(sender,%20receiver)%20=%20mpsc::channel(32);%0A%20%20%20%20let%20ping_handler_task%20=%20tokio::spawn(ping_handler(receiver));%0A%20%20%20%20for%20i%20in%200..10%20{%0A%20%20%20%20%20%20%20%20sender.send(()).await.expect("Failed%20to%20send%20ping.");%0A%20%20%20%20%20%20%20%20println!("Sent%20{}%20pings%20so%20far.",%20i%20+%201);%0A%20%20%20%20}%0A%0A%20%20%20%20drop(sender);%0A%20%20%20%20ping_handler_task.await.expect("Something%20went%20wrong%20in%20ping%20handler%20task.");%0A})
  >>
  /F 4
  /StructParent 118
  /Contents (https://play.rust-lang.org/?version=stable&mode=debug&edition=2024&code=use%20tokio::sync::mpsc;%0A%0Aasync%20fn%20ping_handler(mut%20input:%20mpsc::Receiver<()>)%20{%0A%20%20%20%20let%20mut%20count:%20usize%20=%200;%0A%0A%20%20%20%20while%20let%20Some(_)%20=%20input.recv().await%20{%0A%20%20%20%20%20%20%20%20count%20+=%201;%0A%20%20%20%20%20%20%20%20println!("Received%20{count}%20pings%20so%20far.");%0A%20%20%20%20}%0A%0A%20%20%20%20println!("ping_handler%20complete");%0A}%0A%0A#[tokio::main]%0Aasync%20fn%20main()%20{%0A%20%20%20%20let%20(sender,%20receiver)%20=%20mpsc::channel(32);%0A%20%20%20%20let%20ping_handler_task%20=%20tokio::spawn(ping_handler(receiver));%0A%20%20%20%20for%20i%20in%200..10%20{%0A%20%20%20%20%20%20%20%20sender.send(()).await.expect("Failed%20to%20send%20ping.");%0A%20%20%20%20%20%20%20%20println!("Sent%20{}%20pings%20so%20far.",%20i%20+%201);%0A%20%20%20%20}%0A%0A%20%20%20%20drop(sender);%0A%20%20%20%20ping_handler_task.await.expect("Something%20went%20wrong%20in%20ping%20handler%20task.");%0A})
